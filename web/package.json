{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "supabase db push --workdir ..",
    "db:status": "supabase migration list --workdir ..",
    "db:new": "supabase migration new --workdir ..",
    "db:diff": "supabase db diff --workdir ..",
    "db:types": "supabase gen types typescript --linked --workdir .. > lib/database.types.ts",
    "db:reset": "supabase db reset --workdir ..",
    "db:repair": "supabase migration repair --status applied --workdir .."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "next": "^16.2.3",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.3",
    "prettier": "^3.8.2",
    "shadcn": "^4.2.0",
    "supabase": "^2.91.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  }
}
