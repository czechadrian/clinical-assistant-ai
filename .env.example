# ============================================================
# .env.example — commit this file, never commit the real ones
# Copy the relevant section into the right file:
#   web/.env.local   → Next.js frontend
#   ingest/.env      → FastAPI backend
# ============================================================

# ------------------------------------------------------------
# web/.env.local  (Next.js — Vercel)
# NEXT_PUBLIC_* is embedded into the client bundle at build
# time. Only put values here that are safe to be public.
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical name for the FastAPI backend URL.
# NEXT_PUBLIC_BACKEND_URL is also accepted as a fallback for existing setups.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------
# ingest/.env  (FastAPI — server only, never reaches browser)
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000
# Optional regex for Vercel preview URLs, e.g.: https://myapp-.*\.vercel\.app
CORS_ORIGIN_REGEX=

# ------------------------------------------------------------
# Shared
# ------------------------------------------------------------
APP_ENV=local
